{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Ondrya latency probe",
  "uid": "ondrya-probe",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "ondrya",
    "probe"
  ],
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(probe_build_info, instance)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Self-test",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "min(probe_selftest_ok{instance=~\"$instance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Degraded (crash loop)",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(probe_crashloop{instance=~\"$instance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Active sessions",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(probe_connections_active{instance=~\"$instance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "FD use",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(probe_open_fds{instance=~\"$instance\"} / probe_fd_limit{instance=~\"$instance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Cert expires in",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "min(probe_cert_expiry_seconds{instance=~\"$instance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1209600
              },
              {
                "color": "green",
                "value": 2592000
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "time() - max(probe_start_time_seconds{instance=~\"$instance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Active sessions",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "probe_connections_active{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Sessions finished by result (per second)",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(probe_connections_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Rejected requests by reason (per second)",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(probe_rejected_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Capacity and per_ip rejections are the abuse controls working. Host, origin and subprotocol rejections are scanners or a misconfigured site.",
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Session duration quantiles",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(probe_session_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (rate(probe_session_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(probe_session_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "probe_goroutines{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Flat is healthy. A staircase that never comes down is runbook cause 1.",
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Open file descriptors and limit",
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "probe_open_fds{instance=~\"$instance\"}",
          "legendFormat": "open {{instance}}",
          "refId": "A"
        },
        {
          "expr": "probe_fd_limit{instance=~\"$instance\"}",
          "legendFormat": "limit {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Memory (Go runtime total)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "probe_memory_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Accept errors by class (per second)",
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (error) (rate(probe_accept_errors_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{error}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Timeouts, panics, certificate reload failures (per second)",
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(probe_read_timeouts_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "read timeouts",
          "refId": "A"
        },
        {
          "expr": "rate(probe_write_timeouts_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "write timeouts",
          "refId": "B"
        },
        {
          "expr": "rate(probe_panics_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "panics",
          "refId": "C"
        },
        {
          "expr": "rate(probe_cert_reload_failures_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "cert reload failures",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Self-test consecutive failures",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "probe_selftest_failures_consecutive{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "The process exits with code 70 at 3.",
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Pings answered (per second)",
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(probe_pings_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 17
    }
  ]
}