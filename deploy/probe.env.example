# One configuration for both ways of running the probe.
#
#   systemd: install as /etc/ondrya-probe/probe.env (unit: deploy/ondrya-probe.service)
#   docker:  docker compose --env-file /etc/ondrya-probe/probe.env up -d
#
# Plain KEY=value lines, no quotes, no "export". Nothing here is a default:
# each value is the owner's decision. Any other PROBE_<FLAG> can be added; see
# `ondrya-probe --help`.

# --- who this node is -------------------------------------------------------
PROBE_HOSTNAME=
PROBE_LISTEN=:8443
# Exact origins, comma separated, no wildcards. http is accepted only for localhost/127.0.0.1
# (testing); remove those before going live. Echoed back in CORS headers on /ping and /info.
# Example: https://ondrya.com,https://www.ondrya.com
PROBE_ALLOWED_ORIGINS=
PROBE_NODE_ID=
PROBE_REGION=

# --- certificate: the one Let's Encrypt (certbot) already issued -------------
# The probe serves <dir>/live/<name>/fullchain.pem and privkey.pem, where <name>
# is the hostname unless PROBE_TLS_CERT_NAME says otherwise (certbot names a
# lineage "host-0001" when it had to avoid a clash; see `certbot certificates`).
# It picks up renewals by itself within 10 s. No restart, no renewal hook.
PROBE_TLS_LETSENCRYPT_DIR=/etc/letsencrypt
# PROBE_TLS_CERT_NAME=

# Docker only: numeric gid that can read the certbot key files, from
# deploy/grant-cert-access.sh. The systemd unit uses the group name instead.
PROBE_CERT_GID=
# Docker only: image to run, pinned by digest, never latest.
PROBE_IMAGE=

# --- optional ---------------------------------------------------------------
# PROBE_METRICS_LISTEN=127.0.0.1:9109
# PROBE_STATE_DIR=/var/log/ondrya-probe
# PROBE_RUN_DIR=/run/probe
